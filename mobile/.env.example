# Dev local (décommenter et adapter l’IP ; port 5001 si AirPlay occupe 5000)
# EXPO_PUBLIC_API_URL=http://192.168.1.89:5001
# Profil EAS preview-local : npm run android:apk-local (injecte l’IP LAN :5001)

# Production (Render)
EXPO_PUBLIC_API_URL=https://monpermis-api.onrender.com

# Google OAuth (IDs depuis Google Cloud Console)
# Requis en local (.env) ET sur EAS (development / preview / production) :
#   eas env:set --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value '...' --environment preview --visibility plaintext
#   eas env:set --name EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID --value '...' --environment preview --visibility plaintext
# (répéter pour development et production)
# Aussi secrets GitHub Actions pour .github/workflows/build-apk.yml
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=votre_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=votre_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=votre_ios_client_id.apps.googleusercontent.com
