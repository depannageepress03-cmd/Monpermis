# Dev local (décommenter et adapter l’IP ; port 5001 si AirPlay occupe 5000)
# Sur device physique Android release : utiliser un tunnel HTTPS (ngrok / Cloudflare),
# car usesCleartextTraffic=false bloque le HTTP LAN.
# EXPO_PUBLIC_API_URL=http://192.168.1.89:5001
# Profil EAS preview-local : npm run android:apk-local (injecte l’IP LAN :5001 — simulateur iOS OK)

# Production (Render)
EXPO_PUBLIC_API_URL=https://monpermis-api.onrender.com

# Support WhatsApp (10 chiffres locaux ou E.164 sans +). Fallback : 0192878702
# EXPO_PUBLIC_SUPPORT_WHATSAPP=0192878702
