PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/auto-ecole?retryWrites=true&w=majority
JWT_SECRET=changez_moi_secret_jwt_long_et_aleatoire

# URLs front (sans slash final)
CLIENT_URL=https://votre-site-apprenant.onrender.com
ADMIN_CLIENT_URL=https://votre-admin.onrender.com
MONITEUR_CLIENT_URL=https://votre-moniteur.onrender.com
# Origines CORS autorisées (séparées par des virgules). Inclure site + admin + moniteur.
ALLOWED_ORIGINS=https://votre-site-apprenant.onrender.com,https://votre-admin.onrender.com,https://votre-moniteur.onrender.com

# URL publique de l’API (webhook FedaPay, docs)
API_PUBLIC_URL=https://votre-api.onrender.com

# Google OAuth (connexion / inscription avec Gmail — web + mobile).
# Crée les clients OAuth sur https://console.cloud.google.com/apis/credentials
#   GOOGLE_CLIENT_ID           → client « Web application » (JS origin du site + redirect)
#   GOOGLE_ANDROID_CLIENT_ID   → client « Android » (package com.monpermis.app + SHA-1 de la clé de signature)
#   GOOGLE_IOS_CLIENT_ID       → client « iOS » (bundle com.monpermis.app)
# Redirections à déclarer sur le client Web :
#   - Authorized JavaScript origins : https://monpermis-web.onrender.com (+ http://localhost:5175 en dev)
#   - Authorized redirect URIs : https://monpermis-web.onrender.com/oauth2callback (facultatif, popup) et monpermis:/oauth2redirect (fallback natif)
# Sans ces variables, les boutons Google sont masqués (POST /auth/google → GOOGLE_NOT_CONFIGURED).
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM=Monpermis.bj <noreply@monpermis.bj>

# Création d’admins via l’UI (migration / tant qu’aucun superadmin).
# Dès qu’un superadmin existe, seuls les superadmins peuvent créer des admins.
ALLOW_ADMIN_REGISTRATION=true

# Promouvoir un admin existant au rôle superadmin au démarrage du serveur
# (téléphone local 10 chiffres, ex. 0147880143).
# SUPERADMIN_PHONE=0147880143

# (Optionnel / legacy) Ancienne clé Direction — plus utilisée pour le login ni la création.
# Les superadmins se connectent avec téléphone + mot de passe uniquement.
# SUPERADMIN_ACCESS_KEY=

# FedaPay
FEDAPAY_PUBLIC_KEY=pk_live_xxx
FEDAPAY_SECRET_KEY=sk_live_xxx
FEDAPAY_ENVIRONMENT=live
FEDAPAY_WEBHOOK_SECRET=wh_live_xxx
# URL de retour après paiement (souvent l’API qui sert la SPA) :
FEDAPAY_CALLBACK_URL=https://monpermis-api.onrender.com/abonnement
# Webhook FedaPay dans le dashboard :
#   https://monpermis-api.onrender.com/api/webhooks/fedapay
# Événements : transaction.approved, declined, canceled, failed
# Modes sendNow Benin (côté API, mappés depuis mtn/moov/celtiis) :
#   mtn → mtn_open | moov → moov | celtiis → sbin
# Limite API (requêtes / 15 min / IP). Défaut 900.
# API_RATE_LIMIT_MAX=900
# Limites auth (par route, pas global) — échecs login uniquement pour skipSuccessfulRequests
# AUTH_LOGIN_RATE_LIMIT_MAX=12
# AUTH_REGISTER_RATE_LIMIT_MAX=15
# AUTH_RESET_RATE_LIMIT_MAX=8
# AUTH_GOOGLE_RATE_LIMIT_MAX=20

MOBILE_SCHEME=monpermis

# Soft update APK (GET /api/app/version) — optionnel
# MOBILE_LATEST_VERSION=1.0.41
# MOBILE_MIN_VERSION=1.0.30
# MOBILE_APK_URL=https://github.com/depannageepress03-cmd/Monpermis/releases/latest
# MOBILE_RELEASE_NOTES=Corrections paiement et notifications.

# WhatsApp Cloud API (rappels réservation). Sans credentials → log + lien wa.me en dev.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Numéro admin pour les liens wa.me « notifier l’auto-école » (fallback : 0192878702)
# ADMIN_WHATSAPP_NUMBER=0192878702

# Clé pour le job HTTP des rappels WhatsApp (header x-api-key).
# Les rappels tournent aussi in-process toutes les 15 min (comme expire) — idempotents via reminderSentAt.
# CRON_API_KEY=changez_moi_cle_cron_longue_et_aleatoire
#
# Cron externe optionnel (Render Cron / curl), si vous préférez déclencher hors process :
#   curl -X POST "$API_PUBLIC_URL/api/reservations/reminders/run" \
#     -H "x-api-key: $CRON_API_KEY"
# Fenêtre d’envoi : ~2 h avant le début (1h30–2h30).

# Seed admin (optionnel, npm run seed:admin) — crée un superadmin par défaut
# ADMIN_PHONE=0147880143
# ADMIN_PASSWORD=changez_moi_8_car_min
# ADMIN_FULL_NAME=Administrateur
# ADMIN_ROLE=superadmin
# ADMIN_FORCE_ROLE=true

# Cloudinary — audios quiz + images/vidéos cours (secret serveur uniquement)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optionnel (équivalent) : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=
# Dossier Cloudinary pour le code de la route (défaut : monpermis/code)
# CLOUDINARY_FOLDER=monpermis/code

# ElevenLabs TTS (script local : node scripts/tts-chapitre.mjs)
# Clé : https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=sk_...
# Voice ID (Jérôme) : node scripts/tts-chapitre.mjs --list-voices
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v3
